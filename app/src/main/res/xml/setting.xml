<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="GMS">
        <Preference
                android:key="gms_manager"
                android:title="GMS Manager"
                android:summary="Manage Google Mobile Services"/>
    </PreferenceCategory>

    <PreferenceCategory app:title="Tools">
        <Preference
                android:key="mt_manager"
                android:title="MT Manager"
                android:summary="Open MT Manager (v2.26.4 Clone) - APK/DEX editor"/>
    </PreferenceCategory>

    <PreferenceCategory app:title="Root &amp; Kernel">
        <SwitchPreferenceCompat
                app:key="root_hide"
                app:title="Hide Root"
                app:summary="Hide root status from apps"/>

        <SwitchPreferenceCompat
                app:key="root_manager"
                app:title="Root Manager"
                app:summary="Manage root access per-app (Magisk/KernelSU style)"/>

        <SwitchPreferenceCompat
                app:key="zygisk_support"
                app:title="Zygisk Support"
                app:summary="Enable Zygisk injection for modules (Magisk/KernelSU/APatch)"/>

        <SwitchPreferenceCompat
                app:key="lsposed_support"
                app:title="LSPosed / Xposed Support"
                app:summary="Enable LSPosed/Xposed framework for hook injection"/>
    </PreferenceCategory>

    <PreferenceCategory app:title="Security &amp; Privacy">
        <SwitchPreferenceCompat
                app:key="vpn_hide"
                app:title="Hide VPN"
                app:summary="Hide VPN connections from apps"/>

        <SwitchPreferenceCompat
                app:key="integrity_bypass"
                app:title="SafetyNet/Play Integrity Bypass"
                app:summary="Bypass SafetyNet and Play Integrity checks"/>

        <SwitchPreferenceCompat
                app:key="hook_bypass"
                app:title="Hook Detection Bypass"
                app:summary="Bypass Frida, Xposed, Substrate detection"/>

        <SwitchPreferenceCompat
                app:key="frida_hide"
                app:title="Hide Frida"
                app:summary="Hide Frida server from detection"/>

        <SwitchPreferenceCompat
                app:key="xposed_hide"
                app:title="Hide Xposed"
                app:summary="Hide Xposed framework from detection"/>

        <SwitchPreferenceCompat
                app:key="online_bypass"
                app:title="Online Bypass"
                app:summary="Block anti-cheat/analytics network requests"/>
    </PreferenceCategory>

    <PreferenceCategory app:title="Advanced Features">
        <SwitchPreferenceCompat
                app:key="daemon_enable"
                app:title="Daemon Service"
                app:summary="Enable background daemon service"/>

        <SwitchPreferenceCompat
                app:key="use_vpn_network"
                app:title="VPN Network"
                app:summary="Route traffic through VPN"/>

        <SwitchPreferenceCompat
                app:key="disable_flag_secure"
                app:title="Disable Flag Secure"
                app:summary="Allow screenshots in secure apps"/>

        <SwitchPreferenceCompat
                app:key="shell_script"
                app:title="Shell Script Execution"
                app:summary="Enable .sh script execution"/>

        <SwitchPreferenceCompat
                app:key="fake_location"
                app:title="Enhanced Fake Location"
                app:summary="GPS simulation with movement"/>
    </PreferenceCategory>

    <PreferenceCategory app:title="App Dumper">
        <SwitchPreferenceCompat
                app:key="dumper_enable"
                app:title="Enable App Dumper"
                app:summary="Enable IL2CPP/DEX/Unity dumping"/>

        <SwitchPreferenceCompat
                app:key="auto_dump_enabled"
                app:title="Auto Dump on Launch"
                app:summary="Auto-dump IL2CPP when launching apps (OFF by default to prevent FC)"/>

        <Preference
                app:key="dumper_il2cpp"
                app:title="Dump IL2CPP"
                app:summary="Generate dump.cs, il2cpp.h, main.h, game.h"/>

        <Preference
                app:key="dumper_dex"
                app:title="Dump DEX"
                app:summary="Extract APK for decompilation"/>

        <Preference
                app:key="dumper_native"
                app:title="Dump Native SO"
                app:summary="Extract all .so libraries"/>
    </PreferenceCategory>

    <PreferenceCategory app:title="System">
        <Preference
                app:key="view_logs"
                app:title="View Dump Logs"
                app:summary="Open /storage/emulated/0/Download/black/logs/"/>

        <Preference
                app:key="send_logs"
                app:title="Send Logs"
                app:summary="Upload debug logs to developer"/>
    </PreferenceCategory>

</PreferenceScreen>
